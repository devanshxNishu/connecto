# What goes into the source distribution (the wheel only ever holds the package itself).
# The global-exclude lines are a safety net: if somebody points the data folder inside the checkout, none of it can be
# shipped. `python -m build` prints "no previously-included files matching ..." for them; those warnings are expected.
include LICENSE README.md CONTRIBUTING.md SECURITY.md CLAUDE.md
recursive-include docs *.md
recursive-include examples *
recursive-include skills *.md
recursive-include scripts *.py
recursive-include .github *.yml *.md
recursive-include tests *
global-exclude *.py[cod] .DS_Store *.sqlite *.sqlite-wal *.sqlite-shm .env config.yaml
